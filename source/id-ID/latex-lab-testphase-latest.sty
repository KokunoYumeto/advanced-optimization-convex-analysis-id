%% Project-local compatibility loader for MiKTeX 26.5.
%%
%% The installed latex-lab bundle is newer than the installed LaTeX format.
%% Its automatic math module calls socket variables absent from that format.
%% This loader keeps the synchronized low-level structure and automatic
%% paragraph tagging only. The installed higher-level list, formula, table,
%% heading, minipage, and graphics modules target a newer LaTeX format and fail
%% before output. Formula text remains searchable; the edition must not claim
%% PDF/UA until a synchronized toolchain and pinned validator pass.
\ProvidesPackage{latex-lab-testphase-latest}
  [2026/08/26 O015 compatible tagged-PDF module loader]
%% tagpdf creates the user-role-map namespace from expl3's random generator.
%% Pin that generator before tagpdf loads so two clean builds receive the same
%% namespace identifier.  This changes no document content or PDF object
%% topology; it only removes a build-to-build random UUID.
\ExplSyntaxOn
\sys_gset_rand_seed:n { 20260826 }
\ExplSyntaxOff
\RequirePackage{tagpdf}
\RequirePackage{latex-lab-testphase-names}
\RequirePackage{latex-lab-testphase-new-or-2}
\endinput
