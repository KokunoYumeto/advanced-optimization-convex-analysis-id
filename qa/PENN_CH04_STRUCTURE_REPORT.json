            }
          ],
          "target": [
            {
              "end_line": 57,
              "excerpt": "\\phi(t)=f\\!\\left(\\mathbf{x}_0+t\\nabla f(\\mathbf{x}_0)\\right)",
              "normalized_sha256": "9cbb1069d408ea7f5d7bab3dbb6a07f15c4edc4777ea4078b4d8febb2ee0d8bd",
