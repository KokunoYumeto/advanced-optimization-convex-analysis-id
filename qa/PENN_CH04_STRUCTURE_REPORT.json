            }
          ]
        },
        "O015-PENN-ADV-0027": {
          "pass": true,
          "source": [
            {
              "end_line": 75,
              "excerpt": "Suppose $\\mathbf{p}_k$ is an ascent direction",
              "normalized_sha256": "7ac9ee95e0aa2720b290567c3a7de4927bea7a5ba812f349fe7f4d12bf75a90e",
              "present": true,
              "start_line": 75
            },
            {
              "end_line": 111,
              "excerpt": "The proof of Lemma",
              "normalized_sha256": "74c629865ef6b05900b5d727c21c9c003a389b588920890370eb302a5ca935ca",
              "present": true,
              "start_line": 111
            }
          ],
          "target": [
            {
              "end_line": 85,
              "excerpt": "Misalkan $f$ terdiferensialkan secara kontinu",
              "normalized_sha256": "933c090957a08dff34ad4199e9304a028001100761f3f187843d04beb69d82f1",
              "present": true,
              "start_line": 85
