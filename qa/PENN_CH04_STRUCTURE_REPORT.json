              "present": true,
              "start_line": 200
            }
          ],
          "target": [
            {
              "end_line": 217,
              "excerpt": "Andaikan suatu pemaksimum eksak berhingga $\\delta_k$",
              "normalized_sha256": "0435e1a6cf377e5a80ed6cd08bd482cf031e3b43afd801564f3e8685ca99460f",
              "present": true,
              "start_line": 217
            },
            {
              "end_line": 221,
              "excerpt": "m\\mathbf{I}\\preceq\\mathbf{B}_k\\preceq M\\mathbf{I}",
              "normalized_sha256": "692de3fa0a1543ea5581b43a6e2963d7c7bd8c094c9130589f0526413b3e7a28",
              "present": true,
              "start_line": 221
            },
            {
              "end_line": 228,
              "excerpt": "\\sigma_1\\hat\\delta_k",
              "normalized_sha256": "bba87ba59c0a936a2c812ebea1be7e629fa36b179c2af1f2b6f33c748998e109",
              "present": true,
              "start_line": 228
            }
          ]
        },
        "O015-PENN-ADV-0031": {
          "pass": true,
          "source": [
            {
              "end_line": 216,
              "excerpt": "fix a decreasing step length $\\delta_k = 1$",
              "normalized_sha256": "e9f5f84d4882df01f9917db813d9c626554976888d385ea6e909c1521fe60901",
              "present": true,
              "start_line": 216
            },
            {
              "end_line": 229,
              "excerpt": "x_{k+1} = (-1)^n",
              "normalized_sha256": "75de59b15cf1fa76a78849fc9aa0c13dea63abc9eb75b0d40e76b94b58c16933",
              "present": true,
              "start_line": 229
            }
          ],
          "target": [
            {
              "end_line": 246,
              "excerpt": "tetapkan panjang langkah konstan $\\delta_k=1$",
              "normalized_sha256": "4802c27aa62e923c15135dedd4f60ea10cd42c992707f5cf8121e98f23e724ff",
              "present": true,
              "start_line": 246
            },
            {
