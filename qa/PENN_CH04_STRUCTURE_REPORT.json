              "present": true,
              "start_line": 122
            }
          ]
        },
        "O015-PENN-ADV-0028": {
          "pass": true,
          "source": [
            {
              "end_line": 118,
              "excerpt": "\\lstinputlisting{Code/BackTrace.mpl}",
              "normalized_sha256": "3cf9beca87eb8abc9c7d0e1cdfec6f73266d6f5dad86eae0b2a5c40d9773feba",
              "present": true,
              "start_line": 118
            }
          ],
          "target": [
            {
              "end_line": 129,
              "excerpt": "\\textbf{Masukan:} $\\phi$, $t_0>0$, $\\beta\\in(0,1)$, $\\sigma_1\\in(0,1)$, dan $\\phi'(0)>0$.",
              "normalized_sha256": "d865fd45fb97110c1661f5a650b5d71f7f0379ef1f58edcb5ca3c76a08b98da5",
              "present": true,
              "start_line": 129
            }
          ]
        },
        "O015-PENN-ADV-0029": {
          "pass": true,
          "source": [
            {
              "end_line": 133,
              "excerpt": "Assume that $\\delta_k$ is chosen to ensure the Armijo rule holds",
              "normalized_sha256": "1164d922e32ee9610b877b5d00a314d086ae21243c331f25095d0ee61166b8b9",
              "present": true,
              "start_line": 133
            },
            {
              "end_line": 128,
              "excerpt": "\\limsup_{k \\to \\infty, k\\in K}\\nabla f(\\mathbf{x}_k)^T\\mathbf{p}_k > 0",
              "normalized_sha256": "a7a6a948427f6c5d91c3a31edcfeba0b7431444dfac95c3abfec7e69fe7acf7a",
              "present": true,
              "start_line": 128
            }
          ],
          "target": [
            {
              "end_line": 152,
              "excerpt": "setiap $\\delta_k$ dipilih oleh Algoritma \\ref{alg:BackTrace}",
              "normalized_sha256": "2c216090a404b95833b4e712ecc7a61eb1e1af2599db1bb9eb279974e91d324d",
              "present": true,
              "start_line": 152
            },
            {
              "end_line": 175,
              "excerpt": "\\nabla f(\\mathbf{x}_k)^T\\mathbf{p}_k\\geq\\eta",
              "normalized_sha256": "2102b33bd26b64e21f9055400a1bfc17ddb904689a6c4d201447f71e0b91e304",
              "present": true,
              "start_line": 175
            },
            {
              "end_line": 210,
              "excerpt": "\\nabla f(\\mathbf{x}^+)^T\\mathbf{p}^+ \\leq\\sigma_1",
              "normalized_sha256": "e70f37b4227c7016bbb2ff7f8e8aa86c0bf0a1a597d87b9b97257f43b43feaac",
              "present": true,
              "start_line": 209
            }
          ]
        },
        "O015-PENN-ADV-0030": {
          "pass": true,
          "source": [
            {
              "end_line": 191,
              "excerpt": "Assume that $\\delta_k$ is chosen by maximizing $\\phi(\\delta_k)$",
              "normalized_sha256": "12d0e0b9c52a9bab571a4bcd8034db43629ed6782ba517822058e6f2c818e508",
              "present": true,
              "start_line": 191
            },
            {
              "end_line": 194,
              "excerpt": "every matrix $\\mathbf{B}_k$ is symmetric, positive definite",
              "normalized_sha256": "da95633f4ee2b6a6d184518e197c2f9b7f78d3d6fc5b56781b5ca41d04c4e292",
              "present": true,
              "start_line": 194
            },
            {
              "end_line": 200,
              "excerpt": "\\sigma\\hat{\\delta}_k",
