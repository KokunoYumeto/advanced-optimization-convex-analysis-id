{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "csv_columns": [
    "schema",
    "schema_version",
    "entity_type",
    "id",
    "record_json"
  ],
  "entity_order": [
    "program",
    "course",
    "resource",
    "edition",
    "unit",
    "concept",
    "segment",
    "term",
    "learning_surface",
    "asset",
    "rights",
    "correction",
    "relation",
    "qa_event",
    "artifact"
  ],
  "hash_normalization": {
    "file": "sha256-raw-bytes",
    "segment": "sha256-utf8-lf-final-newline"
  },
  "id_pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$",
  "reference_fields": [
    "affected_segment_ids",
    "affected_unit_ids",
    "build_event_id",
    "concept_id",
    "concept_ids",
    "course_id",
    "edition_id",
    "evidence_artifact_id",
    "evidence_event_ids",
    "input_artifact_ids",
    "parent_id",
    "prerequisite_ids",
    "program_id",
    "related_segment_ids",
    "resource_id",
    "rights_id",
    "source_edition_id",
    "source_artifact_id",
    "source_id",
    "target_edition_id",
    "target_id",
    "unit_id",
    "witness_artifact_ids"
  ],
  "relation_types": [
    "adapts",
    "contains",
    "defines",
    "depends-on",
    "exercises",
    "illustrates",
    "precedes",
    "prerequisite",
    "proves",
    "translates"
  ],
  "required_by_entity": {
    "artifact": ["artifact_kind", "bytes", "path", "sha256"],
    "asset": ["asset_kind", "rights_id", "source_path", "source_sha256", "target_path", "target_sha256"],
    "concept": ["canonical_label"],
    "correction": ["affected_segment_ids", "source_event_id", "source_issue", "target_action", "upstream_report_disposition"],
    "course": ["program_id", "role", "title"],
    "edition": ["edition_kind", "resource_id", "rights_id", "version"],
    "learning_surface": ["presence", "surface_type", "unit_id"],
    "program": ["locale", "title"],
    "qa_event": ["event_type", "result", "witness_artifact_ids"],
    "relation": ["relation_type", "source_id", "target_id"],
    "resource": ["creator", "official_record", "rights_id", "title"],
    "rights": ["authority_url", "component_id", "rights_expression"],
    "segment": ["order", "rights_id", "source_content_sha256", "source_line_end", "source_line_start", "source_path", "target_content_sha256", "target_line_end", "target_line_start", "target_path", "translation_state", "unit_id"],
    "term": ["concept_id", "evidence_segment_ids", "locale", "preferred", "register", "rejected_forms", "scope", "source_term", "variants"],
    "unit": ["edition_id", "order", "source_local_label", "unit_kind"]
  },
  "required_common": [
    "entity_type",
    "id",
    "recorded_at",
    "responsible_workflow",
    "schema",
    "schema_version",
    "status"
  ],
  "schema": "o015-modular-backend-schema",
  "schema_version": "1.0.0",
  "translation_states": [
    "source_frozen",
    "queued",
    "draft",
    "translated",
    "structurally_verified",
    "mathematically_reviewed",
    "language_reviewed",
    "built",
    "visually_checked",
    "published",
    "superseded",
    "blocked"
  ]
}
